# نمونه‌ی فایل keystore.properties — مقادیر واقعی نگذارید!
#
# این فایل را به keystore.properties کپی کنید و مقادیر واقعی بگذارید.
# هر دو فایل keystore.properties و خود keystore در .gitignore هستند و
# هرگز نباید commit شوند.
#
# مسیر storeFile می‌تواند مطلق یا نسبی به ریشه‌ی پروژه باشد؛ توصیه:
# کلید را «بیرون از پوشه‌ی مخزن» نگه دارید (مثلاً ~/.android-keys/acr/).
storeFile=/home/YOUR_USER/.android-keys/acr/release.jks
storePassword=CHANGE_ME_STRONG_PASSWORD
keyAlias=callrecorder
keyPassword=CHANGE_ME_STRONG_PASSWORD
